# Makefile for ChatAFL-ZP test scripts

CC = gcc
CFLAGS = -Wall -Wextra -std=c99
LIBS = -lcurl -ljson-c -lpcre2-8

# Source files
CHAT_LLM_SOURCES = chat-llm.c
TEST_ZHIPU_SOURCES = test_zhipu_api.c
TEST_ZHIPU_ENHANCED_SOURCES = test_zhipu_enhanced.c

# Output files
TEST_ZHIPU_OUTPUT = test_zhipu_api
TEST_ZHIPU_ENHANCED_OUTPUT = test_zhipu_enhanced

# Default target
all: $(TEST_ZHIPU_OUTPUT) $(TEST_ZHIPU_ENHANCED_OUTPUT)

# Build test_zhipu_api
$(TEST_ZHIPU_OUTPUT): $(TEST_ZHIPU_SOURCES) $(CHAT_LLM_SOURCES)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

# Build test_zhipu_enhanced
$(TEST_ZHIPU_ENHANCED_OUTPUT): $(TEST_ZHIPU_ENHANCED_SOURCES) $(CHAT_LLM_SOURCES)
	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)

# Run basic test
test-basic: $(TEST_ZHIPU_OUTPUT)
	./$(TEST_ZHIPU_OUTPUT)

# Run enhanced test with default settings
test-enhanced: $(TEST_ZHIPU_ENHANCED_OUTPUT)
	./$(TEST_ZHIPU_ENHANCED_OUTPUT)

# Run enhanced test with GLM-3-Turbo model
test-glm3: $(TEST_ZHIPU_ENHANCED_OUTPUT)
	./$(TEST_ZHIPU_ENHANCED_OUTPUT) -m zhipu-glm-3-turbo

# Run enhanced test with debug mode
test-debug: $(TEST_ZHIPU_ENHANCED_OUTPUT)
	./$(TEST_ZHIPU_ENHANCED_OUTPUT) -d

# Run enhanced test with all test cases
test-all: $(TEST_ZHIPU_ENHANCED_OUTPUT)
	./$(TEST_ZHIPU_ENHANCED_OUTPUT) -c 5

# Clean build artifacts
clean:
	rm -f $(TEST_ZHIPU_OUTPUT) $(TEST_ZHIPU_ENHANCED_OUTPUT)

# Install dependencies (Ubuntu/Debian)
install-deps:
	sudo apt-get update
	sudo apt-get install -y libcurl4-openssl-dev libjson-c-dev libpcre2-dev

.PHONY: all test-basic test-enhanced test-glm3 test-debug test-all clean install-deps
